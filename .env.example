# Copy to .env and fill in GROQ_API_KEY — it is the one required value; every
# other setting here has a working default in config.py. .env is gitignored.
#
# ingest.py needs no key: embeddings run locally. Only rag.py calls Groq.

# Groq — get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Where the PDFs live
PDF_DIR=/Users/softsuave/RAG

# Postgres + pgvector (note the +psycopg driver, not +psycopg2)
PG_CONNECTION_STRING=postgresql+psycopg://softsuave:softsuave@localhost:5433/rag_ai
COLLECTION_NAME=dev_profiles

# Generation. The model list in Groq's docs is not the list your key can reach —
# check with groq.Groq(api_key=...).models.list(). llama-3.3-70b-versatile, the
# old default here, returns 404 model_not_found on this account.
CHAT_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.4

# Leave MAX_TOKENS empty. gpt-oss and qwen are reasoning models and spend the
# budget on reasoning first, so a small cap returns an empty answer, not a short one.
MAX_TOKENS=
REQUEST_TIMEOUT=60
MAX_RETRIES=2

# Embeddings — local, downloaded once. EMBED_DIM must match the model's output
# width, and it is fixed in the Postgres column the first time the table is
# created. See the README before changing either.
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DIM=768

# Retrieval — changing CHUNK_SIZE/CHUNK_OVERLAP requires: python ingest.py --reset,
# and it invalidates every chunk id in goldenset.json, so re-derive the gold ids.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5

# Ranking strategy. rag.py and evaluate.py both read this, so the retriever that
# is measured is the retriever that ships.
RETRIEVAL_MODE=dense

# How many chunks a ranker pulls before the final top-k cut. "dense" ignores it;
# the evaluation uses it to ask whether a missed chunk was ever fetched at all.
CANDIDATE_K=25

# Where retrieval runs. "local" embeds the corpus in-process and needs no
# database; "pgvector" uses the Postgres collection above.
RETRIEVAL_BACKEND=local
INDEX_CACHE_DIR=.index_cache

# Optional overrides — every value here has a working default in config.py,
# so the project runs fine with no .env at all. No secrets required.

# Where the PDFs live
PDF_DIR=/Users/softsuave/RAG

# Postgres + pgvector (note the +psycopg driver, not +psycopg2)
PG_CONNECTION_STRING=postgresql+psycopg://softsuave:softsuave@localhost:5433/rag_ai
COLLECTION_NAME=dev_profiles

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=deepseek-r1:1.5b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
NUM_CTX=8192
TEMPERATURE=0.4

# Retrieval — raise TOP_K for broad "who knows X?" questions, lower it if
# answers wander. Changing CHUNK_SIZE/CHUNK_OVERLAP requires: python ingest.py --reset
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
